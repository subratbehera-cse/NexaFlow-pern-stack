generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
  CUSTOMER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  NEGOTIATION
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  AWAITING_CUSTOMER_CONFIRMATION
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)

  customer Customer?

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id            Int    @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String @unique
  email         String @unique
  city          String

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int     @id @default(autoincrement())
  productCode String  @unique
  productName String
  category    String
  unit        String
  basePrice   Decimal @db.Decimal(12, 2)

  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  orderItems     SalesOrderItem[]
  dispatchItems  DispatchItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id               Int @id @default(autoincrement())
  productId        Int @unique
  physicalQuantity Int @default(0)
  reservedQuantity Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique
  customerId    Int
  createdById   Int
  enquiryDate   DateTime
  requiredDate  DateTime
  notes         String?
  status        EnquiryStatus @default(NEW)

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  items      EnquiryItem[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique
  enquiryId       Int
  customerId      Int
  createdById     Int
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2)
  gstAmount      Decimal @db.Decimal(12, 2)
  grandTotal     Decimal @db.Decimal(12, 2)

  negotiationMessage String?

  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  items      QuotationItem[]
  salesOrder SalesOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuotationItem {
  id          Int     @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @db.Decimal(5, 2)
  gstPct      Decimal @db.Decimal(5, 2)
  lineAmount  Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([quotationId, productId])
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique
  quotationId Int              @unique
  customerId  Int
  createdById Int
  orderDate   DateTime
  totalAmount Decimal          @db.Decimal(12, 2)
  status      SalesOrderStatus @default(PENDING)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  items      SalesOrderItem[]
  dispatches Dispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesOrderItem {
  id           Int @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatchNumber String   @unique
  salesOrderId   Int
  dispatchDate   DateTime
  vehicleNumber  String
  driverName     String

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  items      DispatchItem[]

  createdAt DateTime @default(now())
}

model DispatchItem {
  id         Int @id @default(autoincrement())
  dispatchId Int
  productId  Int
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([dispatchId, productId])
}